{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build App",
      "detail": "Run the agent against AGENTS.md to build /app from this bundle.",
      "type": "shell",
      "command": "./build.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "echo": true
      },
      "problemMatcher": []
    }
  ]
}
