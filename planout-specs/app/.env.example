# Server port for the Express API (Vite proxies /api/* to it in dev)
PORT=3001

# true  → in-memory seeded mock database (default for local dev)
# false → file-backed JSON database at DB_URL
USE_MOCK_DB=true
DB_URL=file:./.data/consent-iq.json

# Frontend API base URL. Leave EMPTY in dev so requests are same-origin and go through the Vite proxy.
VITE_API_BASE_URL=

# Optional: enable real AI via OpenRouter. When empty, a deterministic local mock is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Simulated ICF generation duration in milliseconds
GENERATION_DURATION_MS=15000
